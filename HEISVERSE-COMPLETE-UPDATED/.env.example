# =====================================================================
# HEISVERSE — Environment template (XAMPP on Windows)
# 1) Copy this file and name the copy  .env
# 2) Fill in the values below. NEVER commit .env to GitHub.
# =====================================================================

# development shows PHP errors on screen; use production on a live site
APP_ENV=development
APP_NAME=HEISVERSE
APP_SECRET=replace_with_a_random_64_character_hex_key_here

# --- Database (XAMPP defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=heisverse
DB_USER=heisverse_user
DB_PASS=YOUR_DATABASE_PASSWORD

# --- TMDB (https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=YOUR_TMDB_API_KEY
TMDB_LANGUAGE=en-US
# seconds to keep TMDB answers in cache/tmdb (3600 = 1 hour)
TMDB_CACHE_TTL=3600
TMDB_TIMEOUT=8

# --- Optional ---
YOUTUBE_API_KEY=
AI_API_KEY=
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HEISVERSE
APP_BASE_URL=http://localhost:8080
